# =============================================================================
#  ConstructionIMS v3 — Environment Variables
#  Copy this file to .env.local and fill in your Supabase project credentials.
# =============================================================================

# Supabase URL (from Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Anon / public key (from Project Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key — server-side only, never expose to the browser.
# Only required if you add admin scripts (e.g. seed.ts).
SUPABASE_SERVICE_ROLE_KEY=eyJ...
